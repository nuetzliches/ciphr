# Rust
/target/
**/*.rs.bk

# Frontend
node_modules/
ui/dist/
# Generated by `npm run notices` and by the image build. It is produced from the
# lockfile every time it is needed, so a copy in the tree could only go stale.
ui/THIRD-PARTY-NOTICES.md

# Local environment and secrets — never commit
.env
.env.*
!.env.example
*.pem
*.key

# Local runtime state
*.db
*.db-wal
*.db-shm
*.jsonl

# Session-local handoff notes, not part of the project record
HANDOFF.md

# Editors and OS
*.stackdump
.DS_Store
.idea/
.vscode/
